{
  "permissions": {
    "deny": [
      "Read(./work/*.html)",
      "Read(./live/**)",
      "Read(./node_modules/**)",
      "Read(./*.zip)",
      "Read(./work/logs/**)",
      "Read(./work/.run/**)",
      "Read(./tools/_old/**)",
      "Read(./.rt-test/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node tools/hook-check.js" }]
      }
    ]
  }
}
