{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node tools/hook-check.js",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./work/*.html)",
      "Read(./live/**)",
      "Read(./node_modules/**)",
      "Read(./*.zip)",
      "Read(./work/logs/**)",
      "Read(./work/.run/**)",
      "Read(./tools/_old/**)",
      "Read(./.rt-test/**)"
    ]
  }
}
